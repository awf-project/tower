.agent/
.grepai/

# Per-PR ZPM memory segments are local working state.
/.zpm/kb/pr_*

# tower workspace dir: the sled index (db/) is regenerated by the scan and the
# extension binaries (extensions/) are built/deployed from the `extensions/` crates —
# both are machine-specific and stay out of git. The hand-authored project config is
# shared, so it is the one tracked file.
.tower/*
!.tower/config.toml

# Runtime debug traces generated by crate tests.
/crates/**/.tower/traces/

# `make dist` build output (release tarballs + checksums).
/dist/

# Documentation site dependencies and Hugo build artifacts.
/site/node_modules/
/site/public/
/site/resources/_gen/
/site/.hugo_build.lock

# Added by awf project-onboard
/target/
debug/
!extensions/debug/
!extensions/debug/**
**/*.rs.bk
*.swp
*.swo
.env
.env.local
*.env
.awf/storage/states/
.awf/storage/logs/
.awf/roles/
.awf/skills/
*.tmp
*.bak

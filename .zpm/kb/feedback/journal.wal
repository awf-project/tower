{"ts":1782237919,"op":"assert","clause":"rule(f003_apply_edits_stale_cas_behavioral_test, test, 'Adapter acceptance tests for workspace/applyEdits stale CAS must invoke dispatch_host_call with an ApplyEditsHostPort fake returning DomainError::VersionConflict; source scans for error-code strings are not sufficient.', high, 'F003 review remediation 2026-06-23')"}
{"ts":1782242326,"op":"assert","clause":"rule(f003_lint_sidecar_rebuild_before_e2e, test, 'Rebuild the lint_extension sidecar binary before rerunning core_engine sidecar e2e tests after changing extensions/lint/src; cargo test -p core_engine alone can reuse the previous target/debug/lint_extension binary.', medium, 'F003 T016 review remediation 2026-06-23')"}
{"ts":1782245172,"op":"assert","clause":"rule(apply_edits_defer_extension_callbacks, architecture, 'When workspace/applyEdits mutates through EngineApplyEditsHost, collect ExtensionHostPort change notifications and fan them out only after releasing EngineState/workspace/index locks; delivering fileChanged inline can re-enter the same sidecar instance and deadlock the original HostCall.', high, 'lint applyEdits reentrant validation 2026-06-23')"}

{"ts":1782233636,"op":"assert","clause":"rule(f003_placeholder_unsupported_operation, pitfall, 'Callable domain contract placeholders must return an unavailable or unsupported-operation error, never a caller-validation variant such as InvalidRange unless the supplied input is actually invalid.', high, 'F003 T010 review remediation 2026-06-23')"}

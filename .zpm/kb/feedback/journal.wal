{"ts":1782211662,"op":"assert","clause":"rule(watcher_delete_uses_file_deleted, architecture, 'Watcher Delete handling must call ExtensionHostPort::on_file_deleted, not on_file_changed; fileChanged subscribers such as fmt must not receive deletion events for removed paths.', high, 'test2.md stale index bug 2026-06-23')"}

{"ts":1782225561,"op":"assert","clause":"rule(extension_tool_route_by_extension_id, pitfall, 'When invoking namespaced extension MCP tools, preserve the matched extension identity; routing by bare local tool name can call the wrong extension when local tool names collide.', high, 'F002 remediation 2026-06-23')"}
